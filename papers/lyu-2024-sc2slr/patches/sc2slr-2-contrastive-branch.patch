diff --git a/modules/criterions.py b/modules/criterions.py
index 348f9f9..e15fdc6 100644
--- a/modules/criterions.py
+++ b/modules/criterions.py
@@ -3,6 +3,21 @@ import torch
 import torch.nn as nn
 import torch.nn.functional as F
 
+class NTXent(nn.Module):
+    """NT-Xent (SimCLR) over 2N embeddings: rows 2i and 2i+1 are the two views of sample i."""
+
+    def __init__(self, temperature=0.5):
+        super(NTXent, self).__init__()
+        self.temperature = temperature
+
+    def forward(self, z):
+        z = F.normalize(z.float(), dim=1)
+        sim = z @ z.t() / self.temperature
+        sim.fill_diagonal_(float('-inf'))
+        targets = torch.arange(z.shape[0], device=z.device) ^ 1
+        return F.cross_entropy(sim, targets)
+
+
 class SeqKD(nn.Module):
     """
     NLL loss with label smoothing.
