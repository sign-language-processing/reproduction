diff --git a/AlphaPose/get_image_keypoint.py b/AlphaPose/get_image_keypoint.py
new file mode 100644
index 0000000..b7932de
--- /dev/null
+++ b/AlphaPose/get_image_keypoint.py
@@ -0,0 +1,24 @@
+import os
+import numpy as np
+
+# Halpe-136 indices of the paper's 90 keypoints (Sec. 3.2): 7 upper body
+# (neck, shoulders, elbows, wrists), 41 face (9 nose, 12 eyes, 20 mouth of the
+# 68-point face block that starts at 26) and 42 hand (left 94-114, right 115-135).
+UPPER_BODY = [18, 5, 6, 7, 8, 9, 10]
+FACE = list(range(26 + 27, 26 + 36)) + list(range(26 + 36, 26 + 48)) + list(range(26 + 48, 26 + 68))
+HANDS = list(range(94, 136))
+SELECTED = UPPER_BODY + FACE + HANDS
+
+
+class Keypoint_getter():
+    """Serves AlphaPose Halpe-136 keypoints precomputed once per frame.
+
+    Files live at <dataset_root>/keypoints-halpe136/<split>/<clip>.npy and hold
+    a (T, 136, 3) float32 array of x, y (pixels of the 256x256 frames) and
+    confidence, in sorted frame-file order.
+    """
+
+    def __call__(self, prefix, folder):
+        clip = os.path.dirname(folder).rstrip("/")
+        keypoints = np.load(os.path.join(prefix, "keypoints-halpe136", clip + ".npy"))
+        return keypoints[:, SELECTED]
diff --git a/AlphaPose/keypoint_to_heatmap.py b/AlphaPose/keypoint_to_heatmap.py
new file mode 100644
index 0000000..d797abf
--- /dev/null
+++ b/AlphaPose/keypoint_to_heatmap.py
@@ -0,0 +1,33 @@
+import numpy as np
+import torch
+
+SIGMA = 4.0  # pixels at 256x256; not stated in the paper
+RADIUS = int(3 * SIGMA)
+
+
+def render_heatmap(keypoints, height, width):
+    """(T, K, 3) keypoints -> (T, H, W) uint8: per pixel, the max over keypoints
+    of confidence * Gaussian(sigma); frames without a detection stay zero."""
+    heatmap = np.zeros((len(keypoints), height, width), dtype=np.float32)
+    offsets = np.arange(-RADIUS, RADIUS + 1)
+    for t, frame in enumerate(keypoints):
+        for x, y, conf in frame:
+            conf = min(max(conf, 0.0), 1.0)
+            cx, cy = int(round(x)), int(round(y))
+            if conf <= 0 or not (-RADIUS <= cx < width + RADIUS and -RADIUS <= cy < height + RADIUS):
+                continue
+            xs, ys = cx + offsets, cy + offsets
+            gx = np.exp(-((xs - x) ** 2) / (2 * SIGMA ** 2))
+            gy = np.exp(-((ys - y) ** 2) / (2 * SIGMA ** 2))
+            keep_x, keep_y = (xs >= 0) & (xs < width), (ys >= 0) & (ys < height)
+            patch = conf * np.outer(gy[keep_y], gx[keep_x])
+            region = heatmap[t, ys[keep_y][0]:ys[keep_y][-1] + 1, xs[keep_x][0]:xs[keep_x][-1] + 1]
+            np.maximum(region, patch, out=region)
+    return np.round(heatmap * 255).astype(np.uint8)
+
+
+def get_heatmap(video, keypoint_getter):
+    """Returns the keypoint heatmap channel of an augmented (T, 4, H, W) video
+    as a (T, H, W) tensor in [0, 1]; it was rendered by the feeder before
+    augmentation so that crops and temporal resampling apply to both alike."""
+    return video[:, 3].float() / 255.0
