+    start_epoch = 0
+    if os.path.exists(resume_path):
+        state = torch.load(resume_path, weights_only=False)
+        slrt_model.load_state_dict(state["model"])
+        sgd_optimizer.load_state_dict(state["optimizer"])
+        scheduler.load_state_dict(state["scheduler"])
+        (start_epoch, train_acc, val_acc, losses, train_accs, val_accs, lr_progress, top_train_acc, top_val_acc,
+         checkpoint_index) = state["loop"]
+        random.setstate(state["rng"][0])
+        np.random.set_state(state["rng"][1])
+        torch.set_rng_state(state["rng"][2])
+        torch.cuda.set_rng_state_all(state["rng"][3])
+        g.set_state(state["rng"][4])
+        print("Resumed after epoch " + str(start_epoch))
+        logging.info("Resumed after epoch " + str(start_epoch))
+
+    for epoch in range(start_epoch, args.epochs):
         train_loss, _, _, train_acc = train_epoch(slrt_model, train_loader, cel_criterion, sgd_optimizer, device)
         losses.append(train_loss.item() / len(train_loader))
         train_accs.append(train_acc)
