+# ---------------------------------------------------------------------------
+# CVSign (Yu et al., ICASSP 2025): CCA and CVA, reimplemented from the paper's
+# Sec. II (Eqs. 1-10) because no CVSign code is published. Values the paper
+# does not state are guesses, recorded in papers/yu-2025-cvsign/README.md.
+# ---------------------------------------------------------------------------
+CCA_CONTEXT_LENGTHS = (3, 5, 9)  # Table VI default, after layers 2/3/4
+CVA_CONTEXT_LENGTHS = (9, 9, 9)  # Table VII default, after layers 2/3/4
+HIDDEN_CHANNELS = 64  # C_hid: not stated in the paper (guess)
+CCA_HEADS = 8  # number of heads: not stated in the paper (guess)
+
+
+def shift_frames(x, m):
+    """X_(m) of Eq. 1: frame t+m for every t of x (N, C, T, H, W).
+
+    Boundary frames are repeated, as Get_Correlation above does; the paper does
+    not state its boundary handling.
+    """
+    index = (torch.arange(x.size(2), device=x.device) + m).clamp(0, x.size(2) - 1)
+    return x.index_select(2, index)
+
+
+def context_offsets(context_len):
+    # The current frame is compared with the other 2n frames of its window
+    # (Fig. 2: "Adjacent 4 Frames" for a context window of 5).
+    n = context_len // 2
+    return [m for m in range(-n, n + 1) if m != 0]
+
+
+class ContextualCorrespondenceAwareness(nn.Module):
+    """CCA, Eqs. 1-6, with the "Full" query area of Table V (Eq. 3 unmasked)."""
+
+    def __init__(self, channels, context_len, hidden_channels=HIDDEN_CHANNELS, heads=CCA_HEADS):
+        super().__init__()
+        self.offsets = context_offsets(context_len)
+        self.heads = heads
+        self.down_conv = nn.Conv3d(channels, hidden_channels, kernel_size=1, bias=False)
+        self.current_conv = nn.Conv3d(hidden_channels, hidden_channels, kernel_size=1, bias=False)
+        self.context_conv = nn.Conv3d(hidden_channels, hidden_channels, kernel_size=1, bias=False)
+        self.conv_back = nn.Conv3d(hidden_channels, channels, kernel_size=1, bias=False)
+
+    def aggregate(self, current, context):
+        """Eqs. 2, 4 and 5 for one context frame X_(m), over all heads."""
+        n, c, t, h, w = current.size()
+        d = c // self.heads
+        query = current.reshape(n, self.heads, d, t, h * w)
+        key = context.reshape(n, self.heads, d, t, h * w)
+        affinity = torch.einsum('nkdtp,nkdtq->nktpq', query, key) / d  # Eq. 2
+        affinity = torch.sigmoid(affinity) - 0.5  # Eq. 4
+        return torch.einsum('nktpq,nkdtq->nkdtp', affinity, key).reshape(n, c, t, h, w)  # Eq. 5
+
+    def forward(self, x):
+        x = self.down_conv(x)
+        current = self.current_conv(x)
+        context = self.context_conv(x)
+        enhanced = 0
+        for m in self.offsets:
+            if self.training:
+                # The affinity has (HW)^2 entries per frame and head. It is
+                # recomputed in backward rather than stored; aggregate() has no
+                # normalisation or randomness, so this is exact.
+                enhanced = enhanced + checkpoint(self.aggregate, current, shift_frames(context, m), use_reentrant=False)
+            else:
+                enhanced = enhanced + self.aggregate(current, shift_frames(context, m))
+        return self.conv_back(enhanced)  # Eq. 6
+
+
+class ContextualVariabilityAwareness(nn.Module):
+    """CVA, Eqs. 7-9."""
+
+    def __init__(self, channels, context_len, hidden_channels=HIDDEN_CHANNELS):
+        super().__init__()
+        self.offsets = context_offsets(context_len)
+        self.down_conv = nn.Conv3d(channels, hidden_channels, kernel_size=1, bias=False)
+        # "three CNNs with a kernel size of 1x3x3"; the normalisation and
+        # activation between them are not stated (guess).
+        self.conv_block = nn.Sequential(
+            nn.Conv3d(hidden_channels, hidden_channels, kernel_size=(1, 3, 3), padding=(0, 1, 1), bias=False),
+            nn.BatchNorm3d(hidden_channels),
+            nn.ReLU(inplace=True),
+            nn.Conv3d(hidden_channels, hidden_channels, kernel_size=(1, 3, 3), padding=(0, 1, 1), bias=False),
+            nn.BatchNorm3d(hidden_channels),
+            nn.ReLU(inplace=True),
+            nn.Conv3d(hidden_channels, hidden_channels, kernel_size=(1, 3, 3), padding=(0, 1, 1), bias=False),
+        )
+        self.conv_back = nn.Conv3d(hidden_channels * len(self.offsets), channels, kernel_size=1, bias=False)
+
+    def forward(self, x):
+        x = self.down_conv(x)
+        differences = torch.cat([x - shift_frames(x, m) for m in self.offsets], dim=0)  # Eq. 7
+        refined = self.conv_block(differences)  # Eq. 8, one Conv_Block shared by every m
+        return self.conv_back(torch.cat(refined.chunk(len(self.offsets), dim=0), dim=1))  # Eq. 9
+
+
+class CVSignBlock(nn.Module):
+    """Eq. 10: X_out = alpha * X_CCA + beta * X_CVA + X_in, alpha = beta = 0 at init."""
+
+    def __init__(self, channels, cca_context_len, cva_context_len):
+        super().__init__()
+        self.cca = ContextualCorrespondenceAwareness(channels, cca_context_len)
+        self.cva = ContextualVariabilityAwareness(channels, cva_context_len)
+        self.alpha = nn.Parameter(torch.zeros(1))
+        self.beta = nn.Parameter(torch.zeros(1))
+
+    def forward(self, x):
+        return self.alpha * self.cca(x) + self.beta * self.cva(x) + x
+
